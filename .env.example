# ============================================================
# Evergreen Mail — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Railway: set these as environment variables in the Railway dashboard.

# APP_URL: Public URL of the deployed application.
# Railway injects this automatically, or set it manually.
APP_URL="http://localhost:3000"

# DATABASE_URL: Database connection string.
# Supports both PostgreSQL (External or Railway/Supabase/Neon/Render) and SQLite.
# Local dev defaults to SQLite ("sqlite:///./evergreen_mail.db") if unset.
# Examples:
# Standard PostgreSQL: DATABASE_URL="postgresql://username:password@hostname:5432/dbname"
# PostgreSQL with SSL: DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
DATABASE_URL="sqlite:///./evergreen_mail.db"

# RESEND_API_KEY: Required for sending emails via Resend (https://resend.com).
# Get your API key from the Resend dashboard.
RESEND_API_KEY="your_resend_api_key_here"

# DEFAULT_FROM_EMAIL: The sender email address for outgoing campaigns.
# Must be a verified domain/sender in your Resend account.
DEFAULT_FROM_EMAIL="onboarding@resend.dev"

# DEFAULT_FROM_NAME: Display name for outgoing emails.
DEFAULT_FROM_NAME="Evergreen Mail"

# DEFAULT_REPLY_TO: Reply-to address for outgoing emails.
DEFAULT_REPLY_TO=""

# API_TARGET: Internal URL of the Python FastAPI backend.
# Used by the Express server to proxy /api requests.
# On Railway this is http://127.0.0.1:8000 (internal co-process).
API_TARGET="http://127.0.0.1:8000"

# GEMINI_API_KEY: Optional, for Gemini AI features.
GEMINI_API_KEY=""
